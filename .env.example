# Alpaca paper trading anahtarlari.
# Bu dosyayi .env olarak kopyalayip kendi anahtarlarini yaz.
# .env dosyasi .gitignore icinde - repoya asla girmez.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# true  -> paper trading (varsayilan, guvenli)
# false -> gercek para. Faz 1 tamamlanip dogrulanmadan ASLA false yapma.
ALPACA_PAPER=true
